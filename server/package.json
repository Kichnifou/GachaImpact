{
  "name": "@gachaimpact/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:manual:player-flow": "node scripts/test-player-flow.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "prisma:generate": "prisma generate",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "jose": "6.2.11",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0"
  }
}
