# HTTP server
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL / Prisma (required by authenticated player routes)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gachaimpact

# Supabase Auth public configuration used for server-side JWKS verification
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# Twitch identity pilot: all three OAuth values and an explicit Player UUID allowlist are required.
# Register TWITCH_REDIRECT_URI exactly as an OAuth redirect URL in the Twitch developer console.
# No chat permission is requested; never put the client secret in Vite variables.
TWITCH_CLIENT_ID=replace-with-twitch-client-id
TWITCH_CLIENT_SECRET=replace-with-twitch-client-secret
TWITCH_REDIRECT_URI=https://your-backend.example/api/v1/me/twitch/callback
TWITCH_PILOT_PLAYER_IDS=replace-with-authorized-player-uuid
TWITCH_PILOT_LOGIN=kichnifou

# Future EventSub webhook transport. Keep disabled and do not set a live secret until a separate activation mission.
TWITCH_EVENTSUB_WEBHOOK_ENABLED=false
# TWITCH_EVENTSUB_SECRET=<server-only 10–100 ASCII characters>
# TWITCH_EVENTSUB_CALLBACK_URL=https://your-backend.example/api/v1/twitch/eventsub
