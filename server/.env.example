# HTTP server
HOST=127.0.0.1
PORT=3001

# PostgreSQL / Prisma (required by authenticated player routes)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gachaimpact

# Supabase Auth public configuration used for server-side JWKS verification
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
