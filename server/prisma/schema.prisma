model PullResult {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pullOperationId    String              @map("pull_operation_id") @db.Uuid
  resultIndex        Int                 @map("result_index") @db.SmallInt
  resultType         String              @map("result_type") @db.Text
  characterId        String?             @map("character_id") @db.Uuid
  rarity             Int?                @db.SmallInt
  resourceKey        String?             @map("resource_key") @db.Text
  resourceAmount     BigInt?             @map("resource_amount")
  wasNewCharacter    Boolean?            @map("was_new_character")
  constellationAfter Int?                @map("constellation_after") @db.SmallInt
