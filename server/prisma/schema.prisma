  @@map("contest_daily_themes")
}

model Contest {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessDate              DateTime                    @map("business_date") @db.Date
  theme                     ContestTheme
  status                    ContestStatus               @default(LOBBY)
  phase                     ContestPhase                @default(LOBBY)
  organizerPlayerId         String?                     @map("organizer_player_id") @db.Uuid
  lobbyDeadlineAt           DateTime?                   @map("lobby_deadline_at") @db.Timestamptz(6)
  turnDeadlineAt            DateTime?                   @map("turn_deadline_at") @db.Timestamptz(6)
  supportDeadlineAt         DateTime?                   @map("support_deadline_at") @db.Timestamptz(6)
  selectedSpectatorPlayerId String?                     @map("selected_spectator_player_id") @db.Uuid
  currentTurnOrder          Int?                        @map("current_turn_order") @db.SmallInt
  currentRound              Int                         @default(1) @map("current_round")
  winnerSlot                Int?                        @map("winner_slot") @db.SmallInt
  startedAt                 DateTime?                   @map("started_at") @db.Timestamptz(6)
  finishedAt                DateTime?                   @map("finished_at") @db.Timestamptz(6)
  cancelledAt               DateTime?                   @map("cancelled_at") @db.Timestamptz(6)
  cancellationKind          ContestCancellationKind?    @map("cancellation_kind")
  cancellationReason        String?                     @map("cancellation_reason") @db.Text
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  dailyTheme                ContestDailyTheme           @relation(fields: [businessDate], references: [businessDate], onDelete: Restrict)
  organizer                 Player?                     @relation("ContestOrganizer", fields: [organizerPlayerId], references: [id], onDelete: Restrict)
  selectedSpectator         Player?                     @relation("ContestSelectedSpectator", fields: [selectedSpectatorPlayerId], references: [id], onDelete: Restrict)
  participants              ContestParticipant[]
  spectators                ContestSpectator[]
  dailyParticipations       ContestDailyParticipation[]
  removals                  ContestLobbyRemoval[]
  events                    ContestEvent[]
  rewards                   ContestReward[]

  @@index([status, createdAt(sort: Desc)], map: "contests_status_created_idx")
  @@index([businessDate, createdAt(sort: Desc)], map: "contests_business_date_idx")
  @@map("contests")
}

model ContestParticipant {
  contestId             String                    @map("contest_id") @db.Uuid
  slot                  Int                       @db.SmallInt
  kind                  ContestParticipantKind
  playerId              String?                   @map("player_id") @db.Uuid
  originalPlayerId      String?                   @map("original_player_id") @db.Uuid
  characterId           String?                   @map("character_id") @db.Uuid
  playerNameSnapshot    String                    @map("player_name_snapshot") @db.Text
  characterNameSnapshot String?                   @map("character_name_snapshot") @db.Text
  avatarSnapshot        String?                   @map("avatar_snapshot") @db.Text
  themeStatSnapshot     Int?                      @map("theme_stat_snapshot") @db.SmallInt
  basePointsSnapshot    Int?                      @map("base_points_snapshot") @db.SmallInt
  titleRankSnapshot     Int                       @default(0) @map("title_rank_snapshot") @db.SmallInt
  score                 Int                       @default(0)
  turnOrder             Int?                      @map("turn_order") @db.SmallInt
  ready                 Boolean                   @default(false)
  inactivityCount       Int                       @default(0) @map("inactivity_count") @db.SmallInt
  eligibleForResult     Boolean                   @default(true) @map("eligible_for_result")
  joinedAt              DateTime                  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt                DateTime?                 @map("left_at") @db.Timestamptz(6)
  replacedAt            DateTime?                 @map("replaced_at") @db.Timestamptz(6)
  replacementReason     ContestReplacementReason? @map("replacement_reason")
  finalRank             Int?                      @map("final_rank") @db.SmallInt
  rewardPrimogems       BigInt                    @default(0) @map("reward_primogems")
  contest               Contest                   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  player                Player?                   @relation("ContestActivePlayer", fields: [playerId], references: [id], onDelete: Restrict)
  originalPlayer        Player?                   @relation("ContestOriginalPlayer", fields: [originalPlayerId], references: [id], onDelete: Restrict)
  character             Character?                @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([contestId, slot])
  @@unique([contestId, playerId], map: "contest_participants_contest_player_key")
  @@unique([contestId, turnOrder], map: "contest_participants_contest_turn_key")
  @@index([playerId], map: "contest_participants_player_idx")
  @@index([originalPlayerId], map: "contest_participants_original_player_idx")
  @@index([characterId], map: "contest_participants_character_idx")
  @@map("contest_participants")
}

