generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlayerStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("player_status")
}

enum FriendshipState {
  ACTIVE
  ARCHIVED

  @@map("friendship_state")
}

enum FriendRequestState {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED

  @@map("friend_request_state")
}

enum PrivacyLevel {
  PUBLIC
  FRIENDS
  PRIVATE

  @@map("privacy_level")
}

enum SourceChannel {
  UI
  INTERNAL_CHAT
  TWITCH
  SYSTEM
  ADMIN
  MIGRATION

  @@map("source_channel")
}

enum GlobalChatMessageType {
  PLAYER
  COMMAND
  GAME_RESULT
  SYSTEM

  @@map("global_chat_message_type")
}

enum GlobalChatDeletionState {
  ACTIVE
  AUTHOR
  MODERATION

  @@map("global_chat_deletion_state")
}

enum OperationStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("operation_status")
}

enum ContestTheme {
  STRENGTH
  INTELLIGENCE
  BEAUTY
  CHARISMA
  POPULARITY

  @@map("contest_theme")
}

enum ContestStatus {
  LOBBY
  RUNNING
  FINISHED
  CANCELLED

  @@map("contest_status")
}

enum ContestPhase {
  LOBBY
  TURNS
  SUPPORT
  FINISHED
  CANCELLED

  @@map("contest_phase")
}

enum ContestParticipantKind {
  HUMAN
  BOT

  @@map("contest_participant_kind")
}

enum ContestCancellationKind {
  ORGANIZER
  TECHNICAL
  ADMIN
  LOBBY_TIMEOUT
  NO_HUMANS

  @@map("contest_cancellation_kind")
}

enum ContestReplacementReason {
  LEFT
  INACTIVE
  ADMIN_REMOVAL

  @@map("contest_replacement_reason")
}

enum ExpeditionState {
  IDLE
  RUNNING
  READY

  @@map("expedition_state")
}

enum NotificationState {
  UNREAD
  READ
  RESOLVED
  ARCHIVED

  @@map("notification_state")
}

enum GiftCodeType {
  ONE_OFF
  ANNUAL

  @@map("gift_code_type")
}

enum GiftCodeStatus {
  DRAFT
  PUBLISHED
  DISABLED

  @@map("gift_code_status")
}

enum EventEditionStatus {
  SCHEDULED
  ACTIVE
  FINISHED

  @@map("event_edition_status")
}

enum DailyChallengeStatus {
  ACTIVE
  COMPLETED
  EXPIRED

  @@map("daily_challenge_status")
}

enum CombatAttemptMode {
  MANUAL
  AUTO

  @@map("combat_attempt_mode")
}

enum BannerStatus {
  ACTIVE
  ENDED

  @@map("banner_status")
}

enum BannerSelectionSource {
  RANDOM
  COMMUNITY_VOTE
  RANDOM_FALLBACK

  @@map("banner_selection_source")
}

model Element {
  key                      String                     @id @db.Text
  displayName              String                     @map("display_name") @db.Text
  displayOrder             Int                        @unique(map: "elements_display_order_key") @map("display_order") @db.SmallInt
  isActive                 Boolean                    @default(true) @map("is_active")
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  resources                ResourceDefinition[]
  players                  Player[]
  characters               Character[]
  combatMatchupsAsAttacker ElementCombatMatchup[]     @relation("CombatAttackerElement")
  combatMatchupsAsDefender ElementCombatMatchup[]     @relation("CombatDefenderElement")
  dailyCombatEnemies       DailyCombatEnemy[]         @relation("DailyCombatEnemyElement")
  dailyCombatMembers       DailyCombatAttemptMember[] @relation("DailyCombatMemberElement")
  monthlyBosses            MonthlyBoss[]              @relation("MonthlyBossResistance")
  bossAttackMembers        BossAttackMember[]         @relation("BossAttackMemberElement")

  @@map("elements")
}

enum TradeRequestState {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED
  EXPIRED

  @@map("trade_request_state")
}

model TradeRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderPlayerId String @map("sender_player_id") @db.Uuid
  recipientPlayerId String @map("recipient_player_id") @db.Uuid
  senderResourceKey String @map("sender_resource_key") @db.Text
  recipientResourceKey String @map("recipient_resource_key") @db.Text
  originalAmount BigInt @map("original_amount")
  currentAmount BigInt @map("current_amount")
  state TradeRequestState @default(PENDING)
  sourceChannel SourceChannel @map("source_channel")
  operationId String @unique @map("operation_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  sender Player @relation("TradeSender", fields: [senderPlayerId], references: [id], onDelete: Restrict)
  recipient Player @relation("TradeRecipient", fields: [recipientPlayerId], references: [id], onDelete: Restrict)
  senderResource ResourceDefinition @relation("TradeSenderResource", fields: [senderResourceKey], references: [key], onDelete: Restrict)
  recipientResource ResourceDefinition @relation("TradeRecipientResource", fields: [recipientResourceKey], references: [key], onDelete: Restrict)
  operation BusinessOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  execution TradeExecution?

  @@index([senderPlayerId, state, createdAt])
  @@index([recipientPlayerId, state, createdAt])
  @@index([state, expiresAt])
  @@map("trade_requests")
}

model TradeExecution {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tradeRequestId String @unique @map("trade_request_id") @db.Uuid
  amount BigInt
  operationId String @unique @map("operation_id") @db.Uuid
  executedAt DateTime @default(now()) @map("executed_at") @db.Timestamptz(6)
  request TradeRequest @relation(fields: [tradeRequestId], references: [id], onDelete: Restrict)
  operation BusinessOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([executedAt])
  @@map("trade_executions")
}

model ResourceDefinition {
  tradesSent TradeRequest[] @relation("TradeSenderResource")
  tradesReceived TradeRequest[] @relation("TradeRecipientResource")
  key               String                  @id @db.Text
  displayName       String                  @map("display_name") @db.Text
  category          String                  @db.Text
  elementKey        String?                 @map("element_key") @db.Text
  isActive          Boolean                 @default(true) @map("is_active")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  element           Element?                @relation(fields: [elementKey], references: [key], onDelete: Restrict)
  playerBalances    PlayerResourceBalance[]
  resourceMovements ResourceMovement[]
  wheelDailyStates  PlayerWheelDailyState[]
  pullResults       PullResult[]
  shopItemsPriced   ShopItemDefinition[]
  giftCodeRewards   GiftCodeReward[]

  @@map("resource_definitions")
}

model Player {
  tradesSent TradeRequest[] @relation("TradeSender")
  tradesReceived TradeRequest[] @relation("TradeRecipient")
  id                    String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName           String                       @map("display_name") @db.Text
  elementKey            String?                      @map("element_key") @db.Text
  status                PlayerStatus                 @default(ACTIVE)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  migrationRunId        String?                      @map("migration_run_id") @db.Uuid
  legacyUsername        String?                      @map("legacy_username") @db.Text
  element               Element?                     @relation(fields: [elementKey], references: [key], onDelete: Restrict)
  webIdentity           WebIdentity?
  businessOperations    BusinessOperation[]
  resourceBalances      PlayerResourceBalance[]
  resourceMovements     ResourceMovement[]
  economyStats          PlayerEconomyStats?
  wheelStats            PlayerWheelStats?
  wheelDailyStates      PlayerWheelDailyState[]
  dailyRewardState      PlayerDailyRewardState?
  progression           PlayerProgression?
  gachaState            PlayerGachaState?
  bannerVotes           BannerVote[]
  characters            PlayerCharacter[]
  c6Progress            C6CompetitionProgress[]
  pullOperations        PullOperation[]
  preferences           PlayerPreference[]
  items                 PlayerItem[]
  itemAcquisitions      ItemAcquisition[]
  eventCollectionAcquisitions EventCollectionAcquisition[]
  teams                 Team[]
  bankAccount           PlayerBankAccount?
  bankTransactions      BankTransaction[]
  shopPurchases         ShopPurchase[]
  dailyChallenges       PlayerDailyChallenge[]
  rolesGranted          PlayerRoleAssignment[]       @relation("RoleSubject")
  rolesGrantedBy        PlayerRoleAssignment[]       @relation("RoleGrantor")
  auditEntriesAsActor   AdminAuditEntry[]            @relation("AuditActor")
  auditEntriesAsTarget  AdminAuditEntry[]            @relation("AuditTarget")
  dailyCombatLoadout    PlayerDailyCombatLoadout?
  dailyCombatStates     PlayerDailyCombatState[]
  dailyCombatKos        PlayerDailyCombatKo[]
  dailyCombatAttempts   DailyCombatAttempt[]
  combatStats           PlayerCombatStats?
  characterCombatStats  PlayerCharacterCombatStats[]
  expedition            PlayerExpedition?
  notifications         Notification[]
  bossLoadout           PlayerBossLoadout?
  bossAttacks           BossAttack[]
  bossParticipations    PlayerBossParticipation[]
  bossStats             PlayerBossStats?
  bossRewards           BossReward[]
  bossFinalBlows        MonthlyBoss[]                @relation("MonthlyBossFinalBlow")
  contestsOrganized     Contest[]                    @relation("ContestOrganizer")
  contestSlots          ContestParticipant[]         @relation("ContestActivePlayer")
  contestOriginalSlots  ContestParticipant[]         @relation("ContestOriginalPlayer")
  chatMentions          GlobalChatMention[]
  chatReportsMade       GlobalChatReport[]           @relation("ChatReportReporter")
  chatReportsReceived   GlobalChatReport[]           @relation("ChatReportReported")
  contestSpectators     ContestSpectator[]
  contestDailyEntries   ContestDailyParticipation[]
  contestRemovals       ContestLobbyRemoval[]
  contestEventsAsActor  ContestEvent[]               @relation("ContestEventActor")
  contestEventsAsTarget ContestEvent[]               @relation("ContestEventTarget")
  contestSupportPicks   Contest[]                    @relation("ContestSelectedSpectator")
  contestRewards        ContestReward[]
  giftCodeClaims        GiftCodeClaim[]
  giftCodesCreated      GiftCode[]                   @relation("GiftCodeCreator")
  giftCodesUpdated      GiftCode[]                   @relation("GiftCodeUpdater")
  eventCurrencyBalances PlayerEventCurrencyBalance[]
  eventParticipations   EventParticipant[]
  eventMilestoneClaims  EventMilestoneClaim[]
  eventCalendarClaims   EventCalendarClaim[]
  eventDailyStates      EventDailyPlayerState[]
  eventGameBDiscoveries  EventGameBDailyState[]
  friendshipsAsA        Friendship[]                 @relation("FriendshipA")
  friendshipsAsB        Friendship[]                 @relation("FriendshipB")
  blocksCreated         PlayerBlock[]                @relation("Blocker")
  blocksReceived        PlayerBlock[]                @relation("Blocked")
  privacySettings       PrivacySetting[]
  sessions              PlayerSession[]
  activityState         PlayerActivityState?
  socialStats           PlayerSocialStats?
  friendRequestsSent    FriendRequest[] @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestRecipient")
  friendHeartsSent       FriendHeart[] @relation("FriendHeartSender")
  friendHeartsReceived   FriendHeart[] @relation("FriendHeartRecipient")
  eventMessagesSent     EventSocialMessage[]         @relation("EventMessageSender")
  eventMessagesReceived EventSocialMessage[]         @relation("EventMessageRecipient")
  globalChatMessages   GlobalChatMessage[]
  globalChatReadState  GlobalChatReadState?

  @@index([status], map: "players_status_idx")
  @@index([elementKey], map: "players_element_key_idx")
  @@map("players")
}

model DailyChallengeDefinition {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalKey      String                 @unique(map: "daily_challenge_definitions_external_key_key") @map("external_key") @db.Text
  type             String                 @db.Text
  target           BigInt
  displayName      String                 @map("display_name") @db.Text
  description      String                 @db.Text
  progressLabel    String                 @map("progress_label") @db.Text
  rewardPrimogems  BigInt                 @map("reward_primogems")
  weight           Int                    @default(1)
  isEnabled        Boolean                @default(true) @map("is_enabled")
  isEligible       Boolean                @default(true) @map("is_eligible")
  displayOrder     Int                    @map("display_order") @db.SmallInt
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  playerChallenges PlayerDailyChallenge[]

  @@index([isEnabled, isEligible, displayOrder], map: "daily_challenge_definitions_pool_idx")
  @@map("daily_challenge_definitions")
}

model PlayerDailyChallenge {
  id                            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId                      String                   @map("player_id") @db.Uuid
  businessDate                  DateTime                 @map("business_date") @db.Date
  definitionId                  String                   @map("definition_id") @db.Uuid
  definitionExternalKeySnapshot String                   @map("definition_external_key_snapshot") @db.Text
  typeSnapshot                  String                   @map("type_snapshot") @db.Text
  displayNameSnapshot           String                   @map("display_name_snapshot") @db.Text
  descriptionSnapshot           String                   @map("description_snapshot") @db.Text
  progressLabelSnapshot         String                   @map("progress_label_snapshot") @db.Text
  targetSnapshot                BigInt                   @map("target_snapshot")
  rewardPrimogemsSnapshot       BigInt                   @map("reward_primogems_snapshot")
  progress                      BigInt                   @default(0)
  status                        DailyChallengeStatus     @default(ACTIVE)
  assignedAt                    DateTime                 @map("assigned_at") @db.Timestamptz(6)
  completedAt                   DateTime?                @map("completed_at") @db.Timestamptz(6)
  switchCount                   Int                      @default(0) @map("switch_count")
  createdAt                     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player                        Player                   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  definition                    DailyChallengeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([playerId, businessDate], map: "player_daily_challenges_player_business_date_key")
  @@index([playerId, status, businessDate], map: "player_daily_challenges_player_status_date_idx")
  @@index([definitionId], map: "player_daily_challenges_definition_id_idx")
  @@map("player_daily_challenges")
}

model PlayerPreference {
  playerId      String   @map("player_id") @db.Uuid
  preferenceKey String   @map("preference_key") @db.Text
  value         Json     @db.JsonB
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, preferenceKey])
  @@map("player_preferences")
}

model ItemDefinition {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalKey    String            @unique(map: "item_definitions_external_key_key") @map("external_key") @db.Text
  displayName    String            @map("display_name") @db.Text
  category       String            @db.Text
  description    String?           @db.Text
  isActive       Boolean           @default(true) @map("is_active")
  metadata       Json?             @db.JsonB
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  playerBalances PlayerItem[]
  acquisitions   ItemAcquisition[]
  eventCollectionAcquisitions EventCollectionAcquisition[]

  @@map("item_definitions")
}

model PlayerItem {
  playerId         String         @map("player_id") @db.Uuid
  itemId           String         @map("item_id") @db.Uuid
  quantity         BigInt         @default(0)
  firstObtainedAt  DateTime?      @map("first_obtained_at") @db.Timestamptz(6)
  legacyProvenance Json?          @map("legacy_provenance") @db.JsonB
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player           Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item             ItemDefinition @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([playerId, itemId])
  @@index([itemId], map: "player_items_item_id_idx")
  @@map("player_items")
}

model ItemAcquisition {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId    String             @map("player_id") @db.Uuid
  itemId      String             @map("item_id") @db.Uuid
  quantity    BigInt
  sourceKey   String             @map("source_key") @db.Text
  provenance  Json?              @db.JsonB
  operationId String?            @map("operation_id") @db.Uuid
  acquiredAt  DateTime           @default(now()) @map("acquired_at") @db.Timestamptz(6)
  player      Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item        ItemDefinition     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  operation   BusinessOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  eventCollectionAcquisition EventCollectionAcquisition?

  @@unique([operationId, itemId], map: "item_acquisitions_operation_item_key")
  @@index([playerId, itemId, acquiredAt(sort: Desc)], map: "item_acquisitions_player_item_acquired_idx")
  @@index([itemId, acquiredAt(sort: Desc)], map: "item_acquisitions_item_acquired_idx")
  @@map("item_acquisitions")
}

model Character {
  id                        String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalKey               String                         @unique(map: "characters_external_key_key") @map("external_key") @db.Text
  name                      String                         @db.Text
  rarity                    Int                            @db.SmallInt
  elementKey                String                         @map("element_key") @db.Text
  weaponType                String?                        @map("weapon_type") @db.Text
  region                    String?                        @db.Text
  classKey                  String?                        @map("class_key") @db.Text
  iconPath                  String?                        @map("icon_path") @db.Text
  splashPath                String?                        @map("splash_path") @db.Text
  wishPath                  String?                        @map("wish_path") @db.Text
  fullbodyPath              String?                        @map("fullbody_path") @db.Text
  displayOrder              Int?                           @map("display_order")
  isActive                  Boolean                        @default(true) @map("is_active")
  releaseDate               DateTime?                      @map("release_date") @db.Date
  sourceMetadata            Json?                          @map("source_metadata") @db.JsonB
  createdAt                 DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  element                   Element                        @relation(fields: [elementKey], references: [key], onDelete: Restrict)
  bannerAppearances         BannerFeaturedCharacter[]
  bannerVotes               BannerVote[]
  selectedByGachaStates     PlayerGachaState[]
  playerPossessions         PlayerCharacter[]
  c6Progress                C6CompetitionProgress[]
  contestParticipants       ContestParticipant[]
  pullTargets               PullOperation[]
  pullResults               PullResult[]
  teamMemberships           TeamMember[]
  dailyCombatEnemies        DailyCombatEnemy[]
  dailyCombatLoadoutSlots   PlayerDailyCombatLoadoutSlot[]
  dailyCombatKos            PlayerDailyCombatKo[]
  dailyCombatAttemptMembers DailyCombatAttemptMember[]
  playerCombatStats         PlayerCharacterCombatStats[]
  playerExpeditions         PlayerExpedition[]
  bossLoadoutSlots          PlayerBossLoadoutSlot[]
  bossAttackMembers         BossAttackMember[]

  @@index([isActive, rarity], map: "characters_active_rarity_idx")
  @@index([elementKey, isActive], map: "characters_element_active_idx")
  @@map("characters")
}

model BannerRotation {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startsAt           DateTime                  @unique(map: "banner_rotations_starts_at_key") @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime                  @map("ends_at") @db.Timestamptz(6)
  status             BannerStatus
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  featuredCharacters BannerFeaturedCharacter[]
  votes              BannerVote[]
  pullOperations     PullOperation[]

  @@index([status], map: "banner_rotations_status_idx")
  @@map("banner_rotations")
}

model BannerFeaturedCharacter {
  bannerRotationId String                @map("banner_rotation_id") @db.Uuid
  characterId      String                @map("character_id") @db.Uuid
  rarity           Int                   @db.SmallInt
  slot             Int                   @db.SmallInt
  selectionSource  BannerSelectionSource @map("selection_source")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  bannerRotation   BannerRotation        @relation(fields: [bannerRotationId], references: [id], onDelete: Cascade)
  character        Character             @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([bannerRotationId, characterId])
  @@unique([bannerRotationId, rarity, slot], map: "banner_featured_characters_banner_rarity_slot_key")
  @@map("banner_featured_characters")
}

model BannerVote {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bannerRotationId String         @map("banner_rotation_id") @db.Uuid
  playerId         String         @map("player_id") @db.Uuid
  characterId      String         @map("character_id") @db.Uuid
  sourceChannel    SourceChannel  @map("source_channel")
  votedAt          DateTime       @default(now()) @map("voted_at") @db.Timestamptz(6)
  bannerRotation   BannerRotation @relation(fields: [bannerRotationId], references: [id], onDelete: Restrict)
  player           Player         @relation(fields: [playerId], references: [id], onDelete: Restrict)
  character        Character      @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@unique([bannerRotationId, playerId], map: "banner_votes_banner_player_key")
  @@index([bannerRotationId, characterId], map: "banner_votes_banner_character_idx")
  @@map("banner_votes")
}

model PlayerGachaState {
  playerId                  String     @id @map("player_id") @db.Uuid
  pity5                     Int        @default(0) @map("pity_5") @db.SmallInt
  pity4                     Int        @default(0) @map("pity_4") @db.SmallInt
  guaranteedFeatured5       Boolean    @default(false) @map("guaranteed_featured_5")
  captureProgress           Int        @default(0) @map("capture_progress") @db.SmallInt
  fiftyFiftyLostStreak      Int        @default(0) @map("fifty_fifty_lost_streak")
  selectedBannerCharacterId String?    @map("selected_banner_character_id") @db.Uuid
  totalPulls                BigInt     @default(0) @map("total_pulls")
  totalFiveStars            BigInt     @default(0) @map("total_five_stars")
  totalFourStars            BigInt     @default(0) @map("total_four_stars")
  fiftyFiftyWon             BigInt     @default(0) @map("fifty_fifty_won")
  fiftyFiftyLost            BigInt     @default(0) @map("fifty_fifty_lost")
  capturesTriggered         BigInt     @default(0) @map("captures_triggered")
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player                    Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  selectedBannerCharacter   Character? @relation(fields: [selectedBannerCharacterId], references: [id], onDelete: SetNull)

  @@index([selectedBannerCharacterId], map: "player_gacha_states_selected_character_idx")
  @@map("player_gacha_states")
}

model PlayerProgression {
  playerId                       String    @id @map("player_id") @db.Uuid
  xp                             BigInt    @default(0)
  level100OverflowRewardsClaimed Int       @default(0) @map("level_100_overflow_rewards_claimed")
  totalMessages                  BigInt    @default(0) @map("total_messages")
  countedMessages                BigInt    @default(0) @map("counted_messages")
  lastXpAt                       DateTime? @map("last_xp_at") @db.Timestamptz(6)
  lastXpMessageAt                DateTime? @map("last_xp_message_at") @db.Timestamptz(6)
  createdAt                      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player                         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_progression")
}

model WebIdentity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId        String   @unique(map: "web_identities_player_id_key") @map("player_id") @db.Uuid
  provider        String   @db.Text
  providerSubject String   @map("provider_subject") @db.Text
  linkedAt        DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)
  state           String   @default("ACTIVE") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject], map: "web_identities_provider_provider_subject_key")
  @@map("web_identities")
}

model BusinessOperation {
  tradeRequest TradeRequest?
  tradeExecution TradeExecution?
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId           String?                 @map("player_id") @db.Uuid
  operationType      String                  @map("operation_type") @db.Text
  sourceChannel      SourceChannel           @map("source_channel")
  idempotencyKey     String?                 @map("idempotency_key") @db.Text
  status             OperationStatus         @default(PENDING)
  resultSummary      Json?                   @map("result_summary") @db.JsonB
  startedAt          DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?               @map("completed_at") @db.Timestamptz(6)
  player             Player?                 @relation(fields: [playerId], references: [id], onDelete: Restrict)
  resourceMovements  ResourceMovement[]
  wheelDailyState    PlayerWheelDailyState?
  dailyRewardState   PlayerDailyRewardState?
  pullOperation      PullOperation?
  bankTransaction    BankTransaction?
  adminAuditEntry    AdminAuditEntry?
  shopPurchase       ShopPurchase?
  dailyCombatAttempt DailyCombatAttempt?
  bossAttack         BossAttack?
  bossRewards        BossReward[]
  contestReward      ContestReward?
  itemAcquisitions   ItemAcquisition[]
  eventCollectionAcquisition EventCollectionAcquisition?
  giftCodeClaim      GiftCodeClaim?
  eventMilestoneClaim EventMilestoneClaim?
  eventCalendarClaim  EventCalendarClaim?
  friendHeart        FriendHeart?
  globalChatMessage  GlobalChatMessage?

  @@index([playerId, startedAt(sort: Desc)], map: "business_operations_player_started_at_idx")
  @@index([operationType, startedAt(sort: Desc)], map: "business_operations_type_started_at_idx")
  @@map("business_operations")
}

model EventDefinition {
  id               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalKey      String                       @unique(map: "event_definitions_external_key_key") @map("external_key") @db.Text
  displayName      String                       @map("display_name") @db.Text
  calendarMonth    Int                          @unique(map: "event_definitions_calendar_month_key") @map("calendar_month") @db.SmallInt
  currencyKey      String                       @unique(map: "event_definitions_currency_key_key") @map("currency_key") @db.Text
  config           Json                         @db.JsonB
  isActive         Boolean                      @default(true) @map("is_active")
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  editions         EventEdition[]
  currencyBalances PlayerEventCurrencyBalance[]

  @@index([isActive, calendarMonth], map: "event_definitions_active_month_idx")
  @@map("event_definitions")
}

model EventEdition {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventDefinitionId String             @map("event_definition_id") @db.Uuid
  year              Int                @db.SmallInt
  startsAt          DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime           @map("ends_at") @db.Timestamptz(6)
  status            EventEditionStatus
  snapshot          Json               @db.JsonB
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  definition        EventDefinition    @relation(fields: [eventDefinitionId], references: [id], onDelete: Restrict)
  participants      EventParticipant[]
  dailyPlayerStates EventDailyPlayerState[]
  gameBDailyStates  EventGameBDailyState[]
  socialMessages    EventSocialMessage[]
  milestoneClaims   EventMilestoneClaim[]
  calendarClaims    EventCalendarClaim[]
  collectionAcquisitions EventCollectionAcquisition[]

  @@unique([eventDefinitionId, year], map: "event_editions_definition_year_key")
  @@index([startsAt, endsAt], map: "event_editions_period_idx")
  @@map("event_editions")
}

model EventCalendarClaim {
  eventEditionId String            @map("event_edition_id") @db.Uuid
  playerId       String            @map("player_id") @db.Uuid
  calendarDay    Int               @map("calendar_day") @db.SmallInt
  rewardAmount   Int               @map("reward_amount") @db.SmallInt
  operationId    String            @unique(map: "event_calendar_claims_operation_id_key") @map("operation_id") @db.Uuid
  claimedAt      DateTime          @default(now()) @map("claimed_at") @db.Timestamptz(6)
  edition        EventEdition      @relation(fields: [eventEditionId], references: [id], onDelete: Restrict)
  player         Player            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  operation      BusinessOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@id([eventEditionId, playerId, calendarDay])
  @@index([playerId], map: "event_calendar_claims_player_idx")
  @@map("event_calendar_claims")
}

model EventCollectionAcquisition {
  eventEditionId    String            @map("event_edition_id") @db.Uuid
  playerId          String            @map("player_id") @db.Uuid
  itemId            String            @map("item_id") @db.Uuid
  itemAcquisitionId String            @unique(map: "event_collection_acquisitions_item_acquisition_key") @map("item_acquisition_id") @db.Uuid
  operationId       String            @unique(map: "event_collection_acquisitions_operation_key") @map("operation_id") @db.Uuid
  acquiredAt        DateTime          @default(now()) @map("acquired_at") @db.Timestamptz(6)
  edition           EventEdition      @relation(fields: [eventEditionId], references: [id], onDelete: Restrict)
  player            Player            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  item              ItemDefinition    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemAcquisition   ItemAcquisition   @relation(fields: [itemAcquisitionId], references: [id], onDelete: Restrict)
  operation         BusinessOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@id([eventEditionId, playerId])
  @@index([playerId], map: "event_collection_acquisitions_player_idx")
  @@index([itemId], map: "event_collection_acquisitions_item_idx")
  @@map("event_collection_acquisitions")
}

model PlayerEventCurrencyBalance {
  playerId          String          @map("player_id") @db.Uuid
  eventDefinitionId String          @map("event_definition_id") @db.Uuid
  amount            BigInt          @default(0)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player            Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  definition        EventDefinition @relation(fields: [eventDefinitionId], references: [id], onDelete: Restrict)

  @@id([playerId, eventDefinitionId])
  @@index([eventDefinitionId], map: "player_event_currency_balances_definition_idx")
  @@map("player_event_currency_balances")
}

model EventParticipant {
  eventEditionId String       @map("event_edition_id") @db.Uuid
  playerId       String       @map("player_id") @db.Uuid
  points         Int          @default(0)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  edition        EventEdition @relation(fields: [eventEditionId], references: [id], onDelete: Restrict)
  player         Player       @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([eventEditionId, playerId])
  @@index([playerId, joinedAt(sort: Desc)], map: "event_participants_player_joined_idx")
  @@map("event_participants")
}

model EventMilestoneClaim {
  eventEditionId String            @map("event_edition_id") @db.Uuid
  playerId       String            @map("player_id") @db.Uuid
  milestone      Int
  operationId    String            @unique(map: "event_milestone_claims_operation_id_key") @map("operation_id") @db.Uuid
  claimedAt      DateTime          @default(now()) @map("claimed_at") @db.Timestamptz(6)
  edition        EventEdition      @relation(fields: [eventEditionId], references: [id], onDelete: Restrict)
  player         Player            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  operation      BusinessOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@id([eventEditionId, playerId, milestone])
  @@index([playerId], map: "event_milestone_claims_player_idx")
  @@map("event_milestone_claims")
}

model EventDailyPlayerState {
  eventEditionId    String       @map("event_edition_id") @db.Uuid
  playerId          String       @map("player_id") @db.Uuid
  businessDate      DateTime     @map("business_date") @db.Date
  gameASuccess      Boolean      @default(false) @map("game_a_success")
  gameAAttempts     Int          @default(0) @map("game_a_attempts")
  gameALastAttemptAt DateTime?   @map("game_a_last_attempt_at") @db.Timestamptz(6)
  gameBAttemptsUsed Int          @default(0) @map("game_b_attempts_used")
  gameCSent         Boolean      @default(false) @map("game_c_sent")
  dailyBonusClaimed Boolean      @default(false) @map("daily_bonus_claimed")
  state             Json         @db.JsonB
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  edition           EventEdition @relation(fields: [eventEditionId], references: [id], onDelete: Cascade)
  player            Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([eventEditionId, playerId, businessDate])
  @@index([playerId, businessDate(sort: Desc)], map: "event_daily_player_states_player_date_idx")
  @@map("event_daily_player_states")
}

model EventGameBDailyState {
  eventEditionId    String       @map("event_edition_id") @db.Uuid
  businessDate      DateTime     @map("business_date") @db.Date
  solutionCode      String       @map("solution_code") @db.Text
  solvedAt          DateTime?    @map("solved_at") @db.Timestamptz(6)
  discovererPlayerId String?    @map("discoverer_player_id") @db.Uuid
  testedCodes       Json         @default("[]") @map("tested_codes") @db.JsonB
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  edition           EventEdition @relation(fields: [eventEditionId], references: [id], onDelete: Cascade)
  discoverer        Player?      @relation(fields: [discovererPlayerId], references: [id], onDelete: SetNull)

  @@id([eventEditionId, businessDate])
  @@index([discovererPlayerId], map: "event_game_b_daily_states_discoverer_idx")
  @@map("event_game_b_daily_states")
}

model Friendship {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerAId       String          @map("player_a_id") @db.Uuid
  playerBId       String          @map("player_b_id") @db.Uuid
  state           FriendshipState @default(ACTIVE)
  level           Int             @default(1)
  totalHearts     BigInt          @default(0) @map("total_hearts")
  becameFriendsAt DateTime?       @map("became_friends_at") @db.Timestamptz(6)
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  playerA         Player          @relation("FriendshipA", fields: [playerAId], references: [id], onDelete: Restrict)
  playerB         Player          @relation("FriendshipB", fields: [playerBId], references: [id], onDelete: Restrict)
  hearts          FriendHeart[]

  @@unique([playerAId, playerBId], map: "friendships_player_pair_key")
  @@index([playerBId], map: "friendships_player_b_idx")
  @@map("friendships")
}

model FriendRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderPlayerId String @map("sender_player_id") @db.Uuid
  recipientPlayerId String @map("recipient_player_id") @db.Uuid
  state FriendRequestState @default(PENDING)
  sourceChannel SourceChannel @map("source_channel")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  sender Player @relation("FriendRequestSender", fields: [senderPlayerId], references: [id], onDelete: Restrict)
  recipient Player @relation("FriendRequestRecipient", fields: [recipientPlayerId], references: [id], onDelete: Restrict)

  @@index([senderPlayerId, state], map: "friend_requests_sender_state_idx")
  @@index([recipientPlayerId, state], map: "friend_requests_recipient_state_idx")
  @@map("friend_requests")
}

model FriendHeart {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  friendshipId String @map("friendship_id") @db.Uuid
  senderPlayerId String @map("sender_player_id") @db.Uuid
  recipientPlayerId String @map("recipient_player_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date
  operationId String @unique(map: "friend_hearts_operation_id_key") @map("operation_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  friendship Friendship @relation(fields: [friendshipId], references: [id], onDelete: Restrict)
  sender Player @relation("FriendHeartSender", fields: [senderPlayerId], references: [id], onDelete: Restrict)
  recipient Player @relation("FriendHeartRecipient", fields: [recipientPlayerId], references: [id], onDelete: Restrict)
  operation BusinessOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@unique([friendshipId, senderPlayerId, businessDate], map: "friend_hearts_daily_key")
  @@index([senderPlayerId, businessDate], map: "friend_hearts_sender_date_idx")
  @@index([recipientPlayerId], map: "friend_hearts_recipient_idx")
  @@map("friend_hearts")
}

model PlayerSocialStats {
  playerId String @id @map("player_id") @db.Uuid
  totalFriendHeartsSent BigInt @default(0) @map("total_friend_hearts_sent")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@map("player_social_stats")
}

model PlayerBlock {
  blockerPlayerId String   @map("blocker_player_id") @db.Uuid
  blockedPlayerId String   @map("blocked_player_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker         Player   @relation("Blocker", fields: [blockerPlayerId], references: [id], onDelete: Cascade)
  blocked         Player   @relation("Blocked", fields: [blockedPlayerId], references: [id], onDelete: Cascade)

  @@id([blockerPlayerId, blockedPlayerId])
  @@index([blockedPlayerId], map: "player_blocks_blocked_idx")
  @@map("player_blocks")
}

model PrivacySetting {
  playerId    String       @map("player_id") @db.Uuid
  categoryKey String       @map("category_key") @db.Text
  level       PrivacyLevel
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, categoryKey])
  @@map("privacy_settings")
}

model PlayerSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId         String    @map("player_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash") @db.Text
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  lastHeartbeatAt  DateTime  @default(now()) @map("last_heartbeat_at") @db.Timestamptz(6)
  lastActivityAt   DateTime? @map("last_activity_at") @db.Timestamptz(6)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(6)
  player           Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, endedAt])
  @@index([lastHeartbeatAt])
  @@map("player_sessions")
}

model PlayerActivityState {
  playerId               String    @id @map("player_id") @db.Uuid
  lastAppActivityAt      DateTime? @map("last_app_activity_at") @db.Timestamptz(6)
  lastInternalChatAt     DateTime? @map("last_internal_chat_at") @db.Timestamptz(6)
  lastTwitchActivityAt   DateTime? @map("last_twitch_activity_at") @db.Timestamptz(6)
  lastGameplayActivityAt DateTime? @map("last_gameplay_activity_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player                 Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_activity_state")
}

model GlobalChatMessage {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorPlayerId   String?                 @map("author_player_id") @db.Uuid
  sourceChannel    SourceChannel           @map("source_channel")
  messageType      GlobalChatMessageType   @map("message_type")
  content          String                  @db.Text
  externalMessageId String?                @map("external_message_id") @db.Text
  operationId      String?                 @unique(map: "global_chat_messages_operation_id_key") @map("operation_id") @db.Uuid
  replyToMessageId String?                 @map("reply_to_message_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(6)
  deletionState    GlobalChatDeletionState @default(ACTIVE) @map("deletion_state")
  generation       Int                     @default(0)
  author           Player?                 @relation(fields: [authorPlayerId], references: [id], onDelete: Restrict)
  operation        BusinessOperation?      @relation(fields: [operationId], references: [id], onDelete: SetNull)
  replyToMessage   GlobalChatMessage?      @relation("GlobalChatReplies", fields: [replyToMessageId], references: [id], onDelete: Restrict)
  replies          GlobalChatMessage[]     @relation("GlobalChatReplies")
  readStates       GlobalChatReadState[]
  mentions         GlobalChatMention[]
  reports          GlobalChatReport[]

  @@unique([sourceChannel, externalMessageId], map: "global_chat_messages_source_external_id_key")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "global_chat_messages_created_id_idx")
  @@index([generation, createdAt(sort: Desc), id(sort: Desc)], map: "global_chat_messages_generation_created_id_idx")
  @@index([authorPlayerId, createdAt(sort: Desc)], map: "global_chat_messages_author_created_idx")
  @@index([replyToMessageId], map: "global_chat_messages_reply_to_idx")
  @@map("global_chat_messages")
}

model GlobalChatState {
  id         Int      @id @default(1) @db.SmallInt
  generation Int      @default(0)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("global_chat_state")
}

model GlobalChatReadState {
  playerId          String            @id @map("player_id") @db.Uuid
  lastReadMessageId String            @map("last_read_message_id") @db.Uuid
  lastReadCreatedAt DateTime          @map("last_read_created_at") @db.Timestamptz(6)
  generation        Int               @default(0)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player            Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  lastReadMessage   GlobalChatMessage @relation(fields: [lastReadMessageId], references: [id], onDelete: Restrict)

  @@index([lastReadMessageId], map: "global_chat_read_states_last_message_idx")
  @@map("global_chat_read_states")
}

model GlobalChatMention {
  messageId         String   @map("message_id") @db.Uuid
  mentionedPlayerId String   @map("mentioned_player_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  message           GlobalChatMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  mentionedPlayer   Player @relation(fields: [mentionedPlayerId], references: [id], onDelete: Restrict)

  @@id([messageId, mentionedPlayerId])
  @@index([mentionedPlayerId, createdAt(sort: Desc)], map: "global_chat_mentions_player_created_idx")
  @@map("global_chat_mentions")
}

model GlobalChatReport {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterPlayerId   String @map("reporter_player_id") @db.Uuid
  messageId          String @map("message_id") @db.Uuid
  reportedPlayerId   String @map("reported_player_id") @db.Uuid
  messageSnapshot    Json   @map("message_snapshot") @db.JsonB
  contextSnapshot    Json   @map("context_snapshot") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  reporter           Player @relation("ChatReportReporter", fields: [reporterPlayerId], references: [id], onDelete: Restrict)
  reported           Player @relation("ChatReportReported", fields: [reportedPlayerId], references: [id], onDelete: Restrict)
  message            GlobalChatMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@unique([reporterPlayerId, messageId], map: "global_chat_reports_reporter_message_key")
  @@index([messageId], map: "global_chat_reports_message_idx")
  @@index([reportedPlayerId, createdAt(sort: Desc)], map: "global_chat_reports_reported_created_idx")
  @@map("global_chat_reports")
}

model EventSocialMessage {
