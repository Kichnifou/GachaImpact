generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlayerStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("player_status")
}

enum SourceChannel {
  UI
  INTERNAL_CHAT
  TWITCH
  SYSTEM
  ADMIN
  MIGRATION

  @@map("source_channel")
}

enum OperationStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("operation_status")
}

enum DailyChallengeStatus {
  ACTIVE
  COMPLETED
  EXPIRED

  @@map("daily_challenge_status")
}

enum CombatAttemptMode {
  MANUAL
  AUTO

  @@map("combat_attempt_mode")
}

enum BannerStatus {
  ACTIVE
  ENDED

  @@map("banner_status")
}

enum BannerSelectionSource {
  RANDOM
  COMMUNITY_VOTE
  RANDOM_FALLBACK

  @@map("banner_selection_source")
}

model Element {
  key                      String                     @id @db.Text
  displayName              String                     @map("display_name") @db.Text
  displayOrder             Int                        @unique(map: "elements_display_order_key") @map("display_order") @db.SmallInt
  isActive                 Boolean                    @default(true) @map("is_active")
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  resources                ResourceDefinition[]
  players                  Player[]
  characters               Character[]
  combatMatchupsAsAttacker ElementCombatMatchup[]     @relation("CombatAttackerElement")
  combatMatchupsAsDefender ElementCombatMatchup[]     @relation("CombatDefenderElement")
  dailyCombatEnemies       DailyCombatEnemy[]         @relation("DailyCombatEnemyElement")
  dailyCombatMembers       DailyCombatAttemptMember[] @relation("DailyCombatMemberElement")

  @@map("elements")
}

model ResourceDefinition {
  key               String                  @id @db.Text
  displayName       String                  @map("display_name") @db.Text
  category          String                  @db.Text
  elementKey        String?                 @map("element_key") @db.Text
  isActive          Boolean                 @default(true) @map("is_active")
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  element           Element?                @relation(fields: [elementKey], references: [key], onDelete: Restrict)
  playerBalances    PlayerResourceBalance[]
  resourceMovements ResourceMovement[]
  wheelDailyStates  PlayerWheelDailyState[]
  pullResults       PullResult[]
  shopItemsPriced   ShopItemDefinition[]

  @@map("resource_definitions")
}

model Player {
  id                   String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName          String                       @map("display_name") @db.Text
  elementKey           String?                      @map("element_key") @db.Text
  status               PlayerStatus                 @default(ACTIVE)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  migrationRunId       String?                      @map("migration_run_id") @db.Uuid
  legacyUsername       String?                      @map("legacy_username") @db.Text
  element              Element?                     @relation(fields: [elementKey], references: [key], onDelete: Restrict)
  webIdentity          WebIdentity?
  businessOperations   BusinessOperation[]
  resourceBalances     PlayerResourceBalance[]
  resourceMovements    ResourceMovement[]
  economyStats         PlayerEconomyStats?
  wheelStats           PlayerWheelStats?
  wheelDailyStates     PlayerWheelDailyState[]
  dailyRewardState     PlayerDailyRewardState?
  progression          PlayerProgression?
  gachaState           PlayerGachaState?
  bannerVotes          BannerVote[]
  characters           PlayerCharacter[]
  c6Progress           C6CompetitionProgress[]
  pullOperations       PullOperation[]
  preferences          PlayerPreference[]
  items                PlayerItem[]
  teams                Team[]
  bankAccount          PlayerBankAccount?
  bankTransactions     BankTransaction[]
  shopPurchases        ShopPurchase[]
  dailyChallenges      PlayerDailyChallenge[]
  rolesGranted         PlayerRoleAssignment[]       @relation("RoleSubject")
  rolesGrantedBy       PlayerRoleAssignment[]       @relation("RoleGrantor")
  auditEntriesAsActor  AdminAuditEntry[]            @relation("AuditActor")
  auditEntriesAsTarget AdminAuditEntry[]            @relation("AuditTarget")
  dailyCombatLoadout   PlayerDailyCombatLoadout?
  dailyCombatStates    PlayerDailyCombatState[]
  dailyCombatKos       PlayerDailyCombatKo[]
  dailyCombatAttempts  DailyCombatAttempt[]
  combatStats          PlayerCombatStats?
  characterCombatStats PlayerCharacterCombatStats[]

  @@index([status], map: "players_status_idx")
  @@index([elementKey], map: "players_element_key_idx")
  @@map("players")
}

model DailyChallengeDefinition {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalKey      String                 @unique(map: "daily_challenge_definitions_external_key_key") @map("external_key") @db.Text
  type             String                 @db.Text
  target           BigInt
  displayName      String                 @map("display_name") @db.Text
  description      String                 @db.Text
  progressLabel    String                 @map("progress_label") @db.Text
  rewardPrimogems  BigInt                 @map("reward_primogems")
  weight           Int                    @default(1)
  isEnabled        Boolean                @default(true) @map("is_enabled")
  isEligible       Boolean                @default(true) @map("is_eligible")
  displayOrder     Int                    @map("display_order") @db.SmallInt
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  playerChallenges PlayerDailyChallenge[]

  @@index([isEnabled, isEligible, displayOrder], map: "daily_challenge_definitions_pool_idx")
  @@map("daily_challenge_definitions")
}

model PlayerDailyChallenge {
  id                            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId                      String                   @map("player_id") @db.Uuid
  businessDate                  DateTime                 @map("business_date") @db.Date
  definitionId                  String                   @map("definition_id") @db.Uuid
  definitionExternalKeySnapshot String                   @map("definition_external_key_snapshot") @db.Text
  typeSnapshot                  String                   @map("type_snapshot") @db.Text
  displayNameSnapshot           String                   @map("display_name_snapshot") @db.Text
  descriptionSnapshot           String                   @map("description_snapshot") @db.Text
  progressLabelSnapshot         String                   @map("progress_label_snapshot") @db.Text
  targetSnapshot                BigInt                   @map("target_snapshot")
  rewardPrimogemsSnapshot       BigInt                   @map("reward_primogems_snapshot")
  progress                      BigInt                   @default(0)
  status                        DailyChallengeStatus     @default(ACTIVE)
  assignedAt                    DateTime                 @map("assigned_at") @db.Timestamptz(6)
  completedAt                   DateTime?                @map("completed_at") @db.Timestamptz(6)
  switchCount                   Int                      @default(0) @map("switch_count")
  createdAt                     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player                        Player                   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  definition                    DailyChallengeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([playerId, businessDate], map: "player_daily_challenges_player_business_date_key")
  @@index([playerId, status, businessDate], map: "player_daily_challenges_player_status_date_idx")
  @@index([definitionId], map: "player_daily_challenges_definition_id_idx")
  @@map("player_daily_challenges")
}

model PlayerPreference {
  playerId      String   @map("player_id") @db.Uuid
  preferenceKey String   @map("preference_key") @db.Text
  value         Json     @db.JsonB
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, preferenceKey])
  @@map("player_preferences")
}

model ItemDefinition {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalKey    String       @unique(map: "item_definitions_external_key_key") @map("external_key") @db.Text
  displayName    String       @map("display_name") @db.Text
  category       String       @db.Text
  description    String?      @db.Text
  isActive       Boolean      @default(true) @map("is_active")
  metadata       Json?        @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  playerBalances PlayerItem[]

  @@map("item_definitions")
}

model PlayerItem {
  playerId         String         @map("player_id") @db.Uuid
  itemId           String         @map("item_id") @db.Uuid
  quantity         BigInt         @default(0)
  firstObtainedAt  DateTime?      @map("first_obtained_at") @db.Timestamptz(6)
  legacyProvenance Json?          @map("legacy_provenance") @db.JsonB
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player           Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item             ItemDefinition @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([playerId, itemId])
  @@index([itemId], map: "player_items_item_id_idx")
  @@map("player_items")
}

model Character {
  id                        String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalKey               String                         @unique(map: "characters_external_key_key") @map("external_key") @db.Text
  name                      String                         @db.Text
  rarity                    Int                            @db.SmallInt
  elementKey                String                         @map("element_key") @db.Text
  weaponType                String?                        @map("weapon_type") @db.Text
  region                    String?                        @db.Text
  classKey                  String?                        @map("class_key") @db.Text
  iconPath                  String?                        @map("icon_path") @db.Text
  splashPath                String?                        @map("splash_path") @db.Text
  wishPath                  String?                        @map("wish_path") @db.Text
  fullbodyPath              String?                        @map("fullbody_path") @db.Text
  displayOrder              Int?                           @map("display_order")
  isActive                  Boolean                        @default(true) @map("is_active")
  releaseDate               DateTime?                      @map("release_date") @db.Date
  sourceMetadata            Json?                          @map("source_metadata") @db.JsonB
  createdAt                 DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  element                   Element                        @relation(fields: [elementKey], references: [key], onDelete: Restrict)
  bannerAppearances         BannerFeaturedCharacter[]
  bannerVotes               BannerVote[]
  selectedByGachaStates     PlayerGachaState[]
  playerPossessions         PlayerCharacter[]
  c6Progress                C6CompetitionProgress[]
  pullTargets               PullOperation[]
  pullResults               PullResult[]
  teamMemberships           TeamMember[]
  dailyCombatEnemies        DailyCombatEnemy[]
  dailyCombatLoadoutSlots   PlayerDailyCombatLoadoutSlot[]
  dailyCombatKos            PlayerDailyCombatKo[]
  dailyCombatAttemptMembers DailyCombatAttemptMember[]
  playerCombatStats         PlayerCharacterCombatStats[]

  @@index([isActive, rarity], map: "characters_active_rarity_idx")
  @@index([elementKey, isActive], map: "characters_element_active_idx")
  @@map("characters")
}

model BannerRotation {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startsAt           DateTime                  @unique(map: "banner_rotations_starts_at_key") @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime                  @map("ends_at") @db.Timestamptz(6)
  status             BannerStatus
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  featuredCharacters BannerFeaturedCharacter[]
  votes              BannerVote[]
  pullOperations     PullOperation[]

  @@index([status], map: "banner_rotations_status_idx")
  @@map("banner_rotations")
}

model BannerFeaturedCharacter {
  bannerRotationId String                @map("banner_rotation_id") @db.Uuid
  characterId      String                @map("character_id") @db.Uuid
  rarity           Int                   @db.SmallInt
  slot             Int                   @db.SmallInt
  selectionSource  BannerSelectionSource @map("selection_source")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  bannerRotation   BannerRotation        @relation(fields: [bannerRotationId], references: [id], onDelete: Cascade)
  character        Character             @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([bannerRotationId, characterId])
  @@unique([bannerRotationId, rarity, slot], map: "banner_featured_characters_banner_rarity_slot_key")
  @@map("banner_featured_characters")
}

model BannerVote {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bannerRotationId String         @map("banner_rotation_id") @db.Uuid
  playerId         String         @map("player_id") @db.Uuid
  characterId      String         @map("character_id") @db.Uuid
  sourceChannel    SourceChannel  @map("source_channel")
  votedAt          DateTime       @default(now()) @map("voted_at") @db.Timestamptz(6)
  bannerRotation   BannerRotation @relation(fields: [bannerRotationId], references: [id], onDelete: Restrict)
  player           Player         @relation(fields: [playerId], references: [id], onDelete: Restrict)
  character        Character      @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@unique([bannerRotationId, playerId], map: "banner_votes_banner_player_key")
  @@index([bannerRotationId, characterId], map: "banner_votes_banner_character_idx")
  @@map("banner_votes")
}

model PlayerGachaState {
  playerId                  String     @id @map("player_id") @db.Uuid
  pity5                     Int        @default(0) @map("pity_5") @db.SmallInt
  pity4                     Int        @default(0) @map("pity_4") @db.SmallInt
  guaranteedFeatured5       Boolean    @default(false) @map("guaranteed_featured_5")
  captureProgress           Int        @default(0) @map("capture_progress") @db.SmallInt
  fiftyFiftyLostStreak      Int        @default(0) @map("fifty_fifty_lost_streak")
  selectedBannerCharacterId String?    @map("selected_banner_character_id") @db.Uuid
  totalPulls                BigInt     @default(0) @map("total_pulls")
  totalFiveStars            BigInt     @default(0) @map("total_five_stars")
  totalFourStars            BigInt     @default(0) @map("total_four_stars")
  fiftyFiftyWon             BigInt     @default(0) @map("fifty_fifty_won")
  fiftyFiftyLost            BigInt     @default(0) @map("fifty_fifty_lost")
  capturesTriggered         BigInt     @default(0) @map("captures_triggered")
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player                    Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  selectedBannerCharacter   Character? @relation(fields: [selectedBannerCharacterId], references: [id], onDelete: SetNull)

  @@index([selectedBannerCharacterId], map: "player_gacha_states_selected_character_idx")
  @@map("player_gacha_states")
}

model PlayerProgression {
  playerId                       String    @id @map("player_id") @db.Uuid
  xp                             BigInt    @default(0)
  level100OverflowRewardsClaimed Int       @default(0) @map("level_100_overflow_rewards_claimed")
  totalMessages                  BigInt    @default(0) @map("total_messages")
  countedMessages                BigInt    @default(0) @map("counted_messages")
  lastXpAt                       DateTime? @map("last_xp_at") @db.Timestamptz(6)
  lastXpMessageAt                DateTime? @map("last_xp_message_at") @db.Timestamptz(6)
  createdAt                      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player                         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_progression")
}

model WebIdentity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId        String   @unique(map: "web_identities_player_id_key") @map("player_id") @db.Uuid
  provider        String   @db.Text
  providerSubject String   @map("provider_subject") @db.Text
  linkedAt        DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)
  state           String   @default("ACTIVE") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject], map: "web_identities_provider_provider_subject_key")
  @@map("web_identities")
}

model BusinessOperation {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId           String?                 @map("player_id") @db.Uuid
  operationType      String                  @map("operation_type") @db.Text
  sourceChannel      SourceChannel           @map("source_channel")
  idempotencyKey     String?                 @map("idempotency_key") @db.Text
  status             OperationStatus         @default(PENDING)
  resultSummary      Json?                   @map("result_summary") @db.JsonB
  startedAt          DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?               @map("completed_at") @db.Timestamptz(6)
  player             Player?                 @relation(fields: [playerId], references: [id], onDelete: Restrict)
  resourceMovements  ResourceMovement[]
  wheelDailyState    PlayerWheelDailyState?
  dailyRewardState   PlayerDailyRewardState?
  pullOperation      PullOperation?
  bankTransaction    BankTransaction?
  adminAuditEntry    AdminAuditEntry?
  shopPurchase       ShopPurchase?
  dailyCombatAttempt DailyCombatAttempt?

  @@index([playerId, startedAt(sort: Desc)], map: "business_operations_player_started_at_idx")
  @@index([operationType, startedAt(sort: Desc)], map: "business_operations_type_started_at_idx")
  @@map("business_operations")
}

model PlayerRoleAssignment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId          String    @map("player_id") @db.Uuid
  role              String    @db.Text
  grantedAt         DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByPlayerId String?   @map("granted_by_player_id") @db.Uuid
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  source            String?   @db.Text
  player            Player    @relation("RoleSubject", fields: [playerId], references: [id], onDelete: Cascade)
  grantedBy         Player?   @relation("RoleGrantor", fields: [grantedByPlayerId], references: [id], onDelete: SetNull)

  @@index([playerId, revokedAt], map: "player_role_assignments_player_revoked_idx")
  @@map("player_role_assignments")
}

model AdminAuditEntry {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorPlayerId  String            @map("actor_player_id") @db.Uuid
  targetPlayerId String            @map("target_player_id") @db.Uuid
  action         String            @db.Text
  domain         String            @db.Text
  before         Json              @db.JsonB
  after          Json              @db.JsonB
  operationId    String            @unique(map: "admin_audit_entries_operation_id_key") @map("operation_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  actor          Player            @relation("AuditActor", fields: [actorPlayerId], references: [id], onDelete: Restrict)
  target         Player            @relation("AuditTarget", fields: [targetPlayerId], references: [id], onDelete: Restrict)
  operation      BusinessOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([actorPlayerId, createdAt(sort: Desc)], map: "admin_audit_entries_actor_created_idx")
  @@index([targetPlayerId, createdAt(sort: Desc)], map: "admin_audit_entries_target_created_idx")
  @@map("admin_audit_entries")
}

model PlayerResourceBalance {
  playerId    String             @map("player_id") @db.Uuid
  resourceKey String             @map("resource_key") @db.Text
  amount      BigInt             @default(0)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player      Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  resource    ResourceDefinition @relation(fields: [resourceKey], references: [key], onDelete: Restrict)

  @@id([playerId, resourceKey])
  @@map("player_resource_balances")
}

model ResourceMovement {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId      String             @map("player_id") @db.Uuid
  resourceKey   String             @map("resource_key") @db.Text
  delta         BigInt
  balanceBefore BigInt             @map("balance_before")
  balanceAfter  BigInt             @map("balance_after")
  causeKey      String             @map("cause_key") @db.Text
  domainKey     String             @map("domain_key") @db.Text
  operationId   String?            @map("operation_id") @db.Uuid
  sourceChannel SourceChannel      @map("source_channel")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  player        Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  resource      ResourceDefinition @relation(fields: [resourceKey], references: [key], onDelete: Restrict)
  operation     BusinessOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@index([playerId, createdAt(sort: Desc)], map: "resource_movements_player_created_at_idx")
  @@index([playerId, resourceKey, createdAt(sort: Desc)], map: "resource_movements_player_resource_created_at_idx")
  @@index([operationId], map: "resource_movements_operation_id_idx")
  @@index([causeKey, createdAt(sort: Desc)], map: "resource_movements_cause_created_at_idx")
  @@map("resource_movements")
}

model PlayerEconomyStats {
  playerId                        String   @id @map("player_id") @db.Uuid
  totalPrimosEarned               BigInt   @default(0) @map("total_primos_earned")
  totalPrimosSpent                BigInt   @default(0) @map("total_primos_spent")
  totalMorasEarned                BigInt   @default(0) @map("total_moras_earned")
  totalMorasSpent                 BigInt   @default(0) @map("total_moras_spent")
  totalMainElementParticlesEarned BigInt   @default(0) @map("total_main_element_particles_earned")
  createdAt                       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player                          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_economy_stats")
}

model PlayerBankAccount {
  playerId         String            @id @map("player_id") @db.Uuid
  balance          BigInt            @default(0)
  lastInterestDate DateTime          @map("last_interest_date") @db.Date
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player           Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  transactions     BankTransaction[]

  @@map("player_bank_accounts")
}

model BankTransaction {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId            String            @map("player_id") @db.Uuid
  transactionType     String            @map("transaction_type") @db.Text
  amount              BigInt
  bankBalanceBefore   BigInt            @map("bank_balance_before")
  bankBalanceAfter    BigInt            @map("bank_balance_after")
  walletBalanceBefore BigInt?           @map("wallet_balance_before")
  walletBalanceAfter  BigInt?           @map("wallet_balance_after")
  businessDate        DateTime?         @map("business_date") @db.Date
  operationId         String            @unique(map: "bank_transactions_operation_id_key") @map("operation_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  player              Player            @relation(fields: [playerId], references: [id], onDelete: Restrict, map: "bank_transactions_player_id_fkey")
  bankAccount         PlayerBankAccount @relation(fields: [playerId], references: [playerId], onDelete: Cascade, map: "bank_transactions_bank_account_fkey")
  operation           BusinessOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, map: "bank_transactions_operation_id_fkey")

  @@index([playerId, createdAt(sort: Desc)], map: "bank_transactions_player_created_at_idx")
  @@index([businessDate], map: "bank_transactions_business_date_idx")
  @@map("bank_transactions")
}

model ShopItemDefinition {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalKey       String             @unique(map: "shop_item_definitions_external_key_key") @map("external_key") @db.Text
  displayName       String             @map("display_name") @db.Text
  description       String             @db.Text
  visualKey         String             @map("visual_key") @db.Text
  priceResourceKey  String             @map("price_resource_key") @db.Text
  priceAmount       BigInt             @map("price_amount")
  effectType        String             @map("effect_type") @db.Text
  effectConfig      Json               @map("effect_config") @db.JsonB
  displayOrder      Int                @map("display_order") @db.SmallInt
  isVisible         Boolean            @default(true) @map("is_visible")
  isEnabled         Boolean            @default(true) @map("is_enabled")
  unavailableReason String?            @map("unavailable_reason") @db.Text
  limitConfig       Json?              @map("limit_config") @db.JsonB
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  priceResource     ResourceDefinition @relation(fields: [priceResourceKey], references: [key], onDelete: Restrict)
  purchases         ShopPurchase[]

  @@index([isVisible, displayOrder], map: "shop_item_definitions_visible_order_idx")
  @@map("shop_item_definitions")
}

model ShopPurchase {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId       String             @map("player_id") @db.Uuid
  shopItemId     String             @map("shop_item_id") @db.Uuid
  quantity       BigInt
  unitPrice      BigInt             @map("unit_price")
  totalPrice     BigInt             @map("total_price")
  effectSnapshot Json               @map("effect_snapshot") @db.JsonB
  operationId    String             @unique(map: "shop_purchases_operation_id_key") @map("operation_id") @db.Uuid
  purchasedAt    DateTime           @default(now()) @map("purchased_at") @db.Timestamptz(6)
  player         Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  shopItem       ShopItemDefinition @relation(fields: [shopItemId], references: [id], onDelete: Restrict)
  operation      BusinessOperation  @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([playerId, purchasedAt(sort: Desc)], map: "shop_purchases_player_purchased_idx")
  @@index([shopItemId, purchasedAt(sort: Desc)], map: "shop_purchases_item_purchased_idx")
  @@map("shop_purchases")
}

model PlayerWheelStats {
  playerId      String   @id @map("player_id") @db.Uuid
  totalSpins    BigInt   @default(0) @map("total_spins")
  totalJackpots BigInt   @default(0) @map("total_jackpots")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_wheel_stats")
}

model PlayerWheelDailyState {
  playerId         String              @map("player_id") @db.Uuid
  businessDate     DateTime            @map("business_date") @db.Date
  spunAt           DateTime?           @map("spun_at") @db.Timestamptz(6)
  resultKnown      Boolean             @default(true) @map("result_known")
  resultType       String?             @map("result_type") @db.Text
  resourceKey      String?             @map("resource_key") @db.Text
  amount           BigInt?
  operationId      String?             @unique(map: "player_wheel_daily_states_operation_id_key") @map("operation_id") @db.Uuid
  legacyProvenance Json?               @map("legacy_provenance") @db.JsonB
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  player           Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  resource         ResourceDefinition? @relation(fields: [resourceKey], references: [key], onDelete: Restrict)
  operation        BusinessOperation?  @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@id([playerId, businessDate])
  @@index([businessDate], map: "player_wheel_daily_states_business_date_idx")
  @@map("player_wheel_daily_states")
}

model PlayerDailyRewardState {
  playerId        String             @id @map("player_id") @db.Uuid
  firstClaimDate  DateTime?          @map("first_claim_date") @db.Date
  lastClaimDate   DateTime?          @map("last_claim_date") @db.Date
  lastClaimedAt   DateTime?          @map("last_claimed_at") @db.Timestamptz(6)
  lastOperationId String?            @unique(map: "player_daily_reward_state_last_operation_id_key") @map("last_operation_id") @db.Uuid
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player          Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  lastOperation   BusinessOperation? @relation(fields: [lastOperationId], references: [id], onDelete: SetNull)

  @@map("player_daily_reward_state")
}

model PlayerCharacter {
  playerId        String    @map("player_id") @db.Uuid
  characterId     String    @map("character_id") @db.Uuid
  constellation   Int       @default(0) @db.SmallInt
  copies          Int       @default(1)
  firstObtainedAt DateTime  @map("first_obtained_at") @db.Timestamptz(6)
  favorite        Boolean   @default(false)
  migrationRunId  String?   @map("migration_run_id") @db.Uuid
  provenance      Json?     @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player          Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  character       Character @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([playerId, characterId])
  @@index([playerId, firstObtainedAt(sort: Desc)], map: "player_characters_player_obtained_idx")
  @@index([characterId], map: "player_characters_character_idx")
  @@map("player_characters")
}

model C6CompetitionProgress {
  playerId     String    @map("player_id") @db.Uuid
  characterId  String    @map("character_id") @db.Uuid
  strength     Int       @default(1) @db.SmallInt
  intelligence Int       @default(1) @db.SmallInt
  beauty       Int       @default(1) @db.SmallInt
  charisma     Int       @default(1) @db.SmallInt
  popularity   Int       @default(1) @db.SmallInt
  unlockedAt   DateTime  @map("unlocked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player       Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  character    Character @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([playerId, characterId])
  @@index([characterId], map: "c6_competition_progress_character_idx")
  @@map("c6_competition_progress")
}

model PullOperation {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId            String            @map("player_id") @db.Uuid
  bannerRotationId    String            @map("banner_rotation_id") @db.Uuid
  targetCharacterId   String            @map("target_character_id") @db.Uuid
  pullCount           Int               @map("pull_count") @db.SmallInt
  primogemCost        BigInt            @map("primogem_cost")
  sourceChannel       SourceChannel     @map("source_channel")
  businessOperationId String            @unique(map: "pull_operations_business_operation_id_key") @map("business_operation_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  player              Player            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  bannerRotation      BannerRotation    @relation(fields: [bannerRotationId], references: [id], onDelete: Restrict)
  targetCharacter     Character         @relation(fields: [targetCharacterId], references: [id], onDelete: Restrict)
  businessOperation   BusinessOperation @relation(fields: [businessOperationId], references: [id], onDelete: Restrict)
  results             PullResult[]

  @@index([playerId, createdAt(sort: Desc)], map: "pull_operations_player_created_at_idx")
  @@index([bannerRotationId], map: "pull_operations_banner_idx")
  @@map("pull_operations")
}

model PullResult {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pullOperationId    String              @map("pull_operation_id") @db.Uuid
  resultIndex        Int                 @map("result_index") @db.SmallInt
  resultType         String              @map("result_type") @db.Text
  characterId        String?             @map("character_id") @db.Uuid
  rarity             Int?                @db.SmallInt
  resourceKey        String?             @map("resource_key") @db.Text
  resourceAmount     BigInt?             @map("resource_amount")
  wasNewCharacter    Boolean?            @map("was_new_character")
  constellationAfter Int?                @map("constellation_after") @db.SmallInt
  copiesAfter        Int?                @map("copies_after")
  wasFiftyFifty      Boolean             @default(false) @map("was_fifty_fifty")
  wonFiftyFifty      Boolean?            @map("won_fifty_fifty")
  guaranteeConsumed  Boolean             @default(false) @map("guarantee_consumed")
  captureTriggered   Boolean             @default(false) @map("capture_triggered")
  snapshot           Json?               @db.JsonB
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  pullOperation      PullOperation       @relation(fields: [pullOperationId], references: [id], onDelete: Cascade)
  character          Character?          @relation(fields: [characterId], references: [id], onDelete: Restrict)
  resource           ResourceDefinition? @relation(fields: [resourceKey], references: [key], onDelete: Restrict)

  @@unique([pullOperationId, resultIndex], map: "pull_results_operation_index_key")
  @@index([characterId], map: "pull_results_character_idx")
  @@index([createdAt(sort: Desc)], map: "pull_results_created_at_idx")
  @@map("pull_results")
}

model Team {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId        String       @map("player_id") @db.Uuid
  displayPosition Int          @map("display_position")
  name            String?      @db.Text
  isActive        Boolean      @default(false) @map("is_active")
  isBaseSlot      Boolean      @default(false) @map("is_base_slot")
  legacySavedAt   DateTime?    @map("legacy_saved_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player          Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  members         TeamMember[]

  @@unique([playerId, displayPosition], map: "teams_player_display_position_key")
  @@index([playerId, isActive], map: "teams_player_active_idx")
  @@map("teams")
}

model TeamMember {
  teamId      String    @map("team_id") @db.Uuid
  position    Int       @db.SmallInt
  characterId String    @map("character_id") @db.Uuid
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([teamId, position])
  @@unique([teamId, characterId], map: "team_members_team_character_key")
  @@index([characterId], map: "team_members_character_id_idx")
  @@map("team_members")
}

model ElementCombatMatchup {
  attackerElementKey String  @map("attacker_element_key") @db.Text
  defenderElementKey String  @map("defender_element_key") @db.Text
  relation           Int     @db.SmallInt
  attackerElement    Element @relation("CombatAttackerElement", fields: [attackerElementKey], references: [key], onDelete: Restrict)
  defenderElement    Element @relation("CombatDefenderElement", fields: [defenderElementKey], references: [key], onDelete: Restrict)

  @@id([attackerElementKey, defenderElementKey])
  @@map("element_combat_matchups")
}

model DailyCombatEncounter {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessDate DateTime                 @unique(map: "daily_combat_encounters_business_date_key") @map("business_date") @db.Date
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  enemies      DailyCombatEnemy[]
  playerStates PlayerDailyCombatState[]
  kos          PlayerDailyCombatKo[]
  attempts     DailyCombatAttempt[]

  @@map("daily_combat_encounters")
}

model DailyCombatEnemy {
  encounterId        String               @map("encounter_id") @db.Uuid
  position           Int                  @db.SmallInt
  characterId        String               @map("character_id") @db.Uuid
  elementKeySnapshot String               @map("element_key_snapshot") @db.Text
  encounter          DailyCombatEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  character          Character            @relation(fields: [characterId], references: [id], onDelete: Restrict)
  elementSnapshot    Element              @relation("DailyCombatEnemyElement", fields: [elementKeySnapshot], references: [key], onDelete: Restrict)

  @@id([encounterId, position])
  @@unique([encounterId, characterId], map: "daily_combat_enemies_encounter_character_key")
  @@index([characterId], map: "daily_combat_enemies_character_idx")
  @@map("daily_combat_enemies")
}

model PlayerDailyCombatLoadout {
  playerId        String                         @id @map("player_id") @db.Uuid
  nextAttemptMode CombatAttemptMode              @default(MANUAL) @map("next_attempt_mode")
  updatedAt       DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player          Player                         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  slots           PlayerDailyCombatLoadoutSlot[]

  @@map("player_daily_combat_loadouts")
}

model PlayerDailyCombatLoadoutSlot {
  playerId    String                   @map("player_id") @db.Uuid
  position    Int                      @db.SmallInt
  characterId String                   @map("character_id") @db.Uuid
  loadout     PlayerDailyCombatLoadout @relation(fields: [playerId], references: [playerId], onDelete: Cascade)
  character   Character                @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([playerId, position])
  @@unique([playerId, characterId], map: "player_daily_combat_slots_player_character_key")
  @@index([characterId], map: "player_daily_combat_slots_character_idx")
  @@map("player_daily_combat_loadout_slots")
}

model PlayerDailyCombatState {
  playerId    String               @map("player_id") @db.Uuid
  encounterId String               @map("encounter_id") @db.Uuid
  wonAt       DateTime?            @map("won_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player      Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  encounter   DailyCombatEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@id([playerId, encounterId])
  @@index([encounterId], map: "player_daily_combat_states_encounter_idx")
  @@map("player_daily_combat_states")
}

model PlayerDailyCombatKo {
  playerId    String               @map("player_id") @db.Uuid
  encounterId String               @map("encounter_id") @db.Uuid
  characterId String               @map("character_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  player      Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  encounter   DailyCombatEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  character   Character            @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([playerId, encounterId, characterId])
  @@index([encounterId], map: "player_daily_combat_kos_encounter_idx")
  @@index([characterId], map: "player_daily_combat_kos_character_idx")
  @@map("player_daily_combat_kos")
}

model DailyCombatAttempt {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId         String                     @map("player_id") @db.Uuid
  encounterId      String                     @map("encounter_id") @db.Uuid
  mode             CombatAttemptMode
  chanceHalfPoints Int                        @map("chance_half_points") @db.SmallInt
  won              Boolean
  rngRoll          Int                        @map("rng_roll") @db.SmallInt
  operationId      String                     @unique(map: "daily_combat_attempts_operation_id_key") @map("operation_id") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  player           Player                     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  encounter        DailyCombatEncounter       @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  operation        BusinessOperation          @relation(fields: [operationId], references: [id], onDelete: Restrict)
  members          DailyCombatAttemptMember[]

  @@index([playerId, encounterId, createdAt(sort: Desc)], map: "daily_combat_attempts_player_encounter_idx")
  @@map("daily_combat_attempts")
}

model DailyCombatAttemptMember {
  attemptId              String             @map("attempt_id") @db.Uuid
  position               Int                @db.SmallInt
  characterId            String             @map("character_id") @db.Uuid
  raritySnapshot         Int                @map("rarity_snapshot") @db.SmallInt
  constellationSnapshot  Int                @map("constellation_snapshot") @db.SmallInt
  elementKeySnapshot     String             @map("element_key_snapshot") @db.Text
  contributionHalfPoints Int                @map("contribution_half_points") @db.SmallInt
  attempt                DailyCombatAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  character              Character          @relation(fields: [characterId], references: [id], onDelete: Restrict)
  elementSnapshot        Element            @relation("DailyCombatMemberElement", fields: [elementKeySnapshot], references: [key], onDelete: Restrict)

  @@id([attemptId, position])
  @@index([characterId], map: "daily_combat_attempt_members_character_idx")
  @@map("daily_combat_attempt_members")
}

model PlayerCombatStats {
  playerId        String   @id @map("player_id") @db.Uuid
  totalFights     BigInt   @default(0) @map("total_fights")
  totalWins       BigInt   @default(0) @map("total_wins")
  totalLosses     BigInt   @default(0) @map("total_losses")
  totalManualWins BigInt   @default(0) @map("total_manual_wins")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_combat_stats")
}

model PlayerCharacterCombatStats {
  playerId    String    @map("player_id") @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  wins        BigInt    @default(0)
  losses      BigInt    @default(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([playerId, characterId])
  @@index([characterId], map: "player_character_combat_stats_character_idx")
  @@map("player_character_combat_stats")
}
